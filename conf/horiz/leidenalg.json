{
  "VERBOSE": 1,
  "CATCH_ERRORS": true,
  "USE_TIMESTAMP_SUFFIX": true,
  
  "DATASETS": [
    "dyn_pubmed", "arxivmath"],
  "BATCHES": ["999:5", "999:10", "999:20", "999:40", "999:80", "999:160", "999:320",
              "99:50", "9:500"],
