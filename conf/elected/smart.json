{
  "VERBOSE": 1,
  "CATCH_ERRORS": true,
  "USE_TIMESTAMP_SUFFIX": true,
  
  "DATASETS": [
    "dyn_cora", "dyn_acm", "dyn_citeseer", "patent", "dyn_pubmed", "arxivmath"],
  "BATCHES": ["999:10"],
  "FORCE_UNDIRECTED": true,
  
  "BASELINES": ["leidenalg", "flmig",
                "prgpt:infomap", "prgpt:locale",
                "s2cag", "lago",
                "magi", "dmon"],
  "MODES": ["smart"],
  "FEATURE_MODES": ["random"],
  "BASELINE_ITERATIONS": [10],
  
  "SMART_PARAMS_GRID": {
    "smart_subcoms_depth": [3],
    "smart_neighborhood_step": [1],
    "aggregation_mode": ["norm"]
  }
}
