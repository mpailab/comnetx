{
  "schema": "comnetx-ieee-access-ldleiden-protocol-v1",
  "protocol_id": "ieee-access-ldleiden-24h-standalone-v1",
  "registered_date": "2026-08-27",
  "purpose": "Measure native LD-Leiden timing, quality, and repeatability on the registered ComNetX graph streams under a sealed standalone bootstrap.",
  "common": {
    "backend": "ldleiden",
    "mode": "dynamic",
    "resolution": 1.0,
    "force_undirected": true,
    "bootstrap_method": "leidenalg",
    "bootstrap_policy": "One canonical cached Leiden partition per dataset and initial graph is reused by every repetition. Native priming must expose and preserve exactly that partition relation before the first measured update.",
    "priming_partition_audit_required": true,
    "source_hash_locked_before_and_after_every_repetition": true,
    "input_content_hash_locked_before_and_after_every_repetition": true,
    "hardware_container_and_wheel_locked_before_and_after_every_repetition": true,
    "num_jobs": 1,
    "num_jobs_source": "verified AlgorithmOptions default",
    "num_jobs_explicitly_passed_by_launcher": false,
    "feature_mode": "dataset",
    "ground_truth_metrics": true
  },
  "clock_policy": {
    "principal_field": "optimization_time",
    "principal_definition": "LD-Leiden optimization inside apply(), excluding its pending graph update.",
    "compatibility_alias": "time",
    "diagnostic_fields": [
      "update_time",
      "end_to_end_time"
    ],
    "required_support_field": "timing_split_supported",
    "required_support_value": true
  },
  "analysis_policy": {
    "smoke_runs_are_excluded": true,
    "short_repetitions_per_dataset": 5,
    "long_repetitions_per_dataset": 3,
    "primary_quality_fields": [
      "Final modularity",
      "NMI"
    ],
    "interpretation": "Report native LD-Leiden as a specialized implementation reference. Use optimization_time as the principal backend clock and report update_time plus end_to_end_time as implementation diagnostics. Do not pool the smoke run with measured repetitions. Cross-era comparisons with historical ComNetX rows are descriptive unless both methods are rerun from the same sealed bootstrap."
  },
  "phases": [
    {
      "id": "smoke_999_10",
      "cli_name": "smoke",
      "role": "diagnostic_only",
      "included_in_analysis": false,
      "config": "configs/ldleiden_smoke_999_10.json",
      "repetitions": 1,
      "batch_strategy": "999:10",
      "datasets": [
        "dyn_cora",
        "dyn_acm",
        "dyn_citeseer",
        "patent",
        "dyn_pubmed",
        "arxivmath"
      ],
      "expected_updates": {
        "dyn_cora": 10,
        "dyn_acm": 10,
        "dyn_citeseer": 8,
        "patent": 10,
        "dyn_pubmed": 10,
        "arxivmath": 10
      }
    },
    {
      "id": "measured_999_10",
      "cli_name": "short",
      "role": "measured_short_horizon",
      "included_in_analysis": true,
      "config": "configs/ldleiden_measured_999_10.json",
      "repetitions": 5,
      "batch_strategy": "999:10",
      "datasets": [
        "dyn_pubmed",
        "arxivmath"
      ],
      "expected_updates": {
        "dyn_pubmed": 10,
        "arxivmath": 10
      }
    },
    {
      "id": "measured_9_500",
      "cli_name": "long",
      "role": "measured_long_horizon",
      "included_in_analysis": true,
      "config": "configs/ldleiden_measured_9_500.json",
      "repetitions": 3,
      "batch_strategy": "9:500",
      "datasets": [
        "dyn_pubmed",
        "arxivmath"
      ],
      "expected_updates": {
        "dyn_pubmed": 500,
        "arxivmath": 500
      }
    }
  ]
}
